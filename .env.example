# ---------------------------------------------------------------------------
# Alerts (required for real delivery; without them the scanner logs only)
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=-1001234567890
# Set to 1 to compute and log alerts without sending them.
DRY_RUN=0
# Safety valve: most alerts sent in a single scan (0 = unlimited).
MAX_ALERTS_PER_SCAN=40

# ---------------------------------------------------------------------------
# Market selection
# ---------------------------------------------------------------------------
QUOTE=USDT
INTERVAL=4h
MIN_MCAP=10000000
MIN_QUOTE_VOLUME_24H=100000
# Set to 0 to disable the 24h quote-volume filter entirely.
ENABLE_VOLUME_FILTER=1
# Leveraged / ETF tokens to exclude, matched against the BASE asset name.
# Default covers Gate's own naming (BTC3L, ETH5S, XRP4L, ...).
# BULL/BEAR/UP/DOWN are intentionally NOT included: those suffixes also appear
# inside real tickers such as JUP and SYRUP. To add them anyway, use:
#   .+(?:3|4|5)(?:L|S)$|.{3,}(?:BULL|BEAR|UP|DOWN)$
LEVERAGED_REGEX=.+(?:3|4|5)(?:L|S)$
# Extra bases to skip, comma separated, e.g. USDC,DAI
EXCLUDE_BASES=
# Debug helpers: restrict the scan to specific pairs / cap the pair count.
ONLY_PAIRS=
MAX_PAIRS=0

# ---------------------------------------------------------------------------
# Market cap source: gate | coingecko | auto
# Gate's /spot/currencies usually does NOT expose a market cap, so "auto"
# reads Gate first and fills every gap from CoinGecko's public API.
# ---------------------------------------------------------------------------
MCAP_SOURCE=auto
COINGECKO_PAGES=8
COINGECKO_API_KEY=
COINGECKO_BASE=https://api.coingecko.com/api/v3

# ---------------------------------------------------------------------------
# Indicators
# ---------------------------------------------------------------------------
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9
EMA_LEN=20
CANDLE_LIMIT=80

# ---------------------------------------------------------------------------
# Gate.io HTTP behaviour / rate limits
# ---------------------------------------------------------------------------
GATE_BASE=https://api.gateio.ws/api/v4
CONCURRENCY=8
# Minimum seconds between outbound Gate requests across all workers.
REQUEST_INTERVAL=0.06
HTTP_TIMEOUT=20
MAX_RETRIES=5
BACKOFF_BASE=1.0
BACKOFF_CAP=30

# ---------------------------------------------------------------------------
# Scheduling and runtime
# ---------------------------------------------------------------------------
# 1 = single scan then exit (use with an external cron). 0 = internal loop.
RUN_ONCE=0
# Seconds to wait after each 4H close before scanning, so Gate settles the bar.
SCAN_BUFFER_SECONDS=90
# Scan the last closed bar immediately on boot (dedupe makes this safe).
SCAN_ON_START=1
# Require the newest closed bar to match the expected timestamp exactly.
STRICT_BAR_TS=1
DATA_DIR=/data
DEDUPE_RETENTION_DAYS=30
LOG_LEVEL=INFO
# Timezone for every time a human reads (Telegram, dashboard, logs).
# DISPLAY ONLY - the scan schedule always follows Gate's UTC candle boundaries.
# In GMT+8 the same 4H closes read as 00:00, 04:00, 08:00, 12:00, 16:00, 20:00.
DISPLAY_TZ=Asia/Kuala_Lumpur

# ---------------------------------------------------------------------------
# Optional HTTP health endpoint (leave off for a Railway worker service)
# ---------------------------------------------------------------------------
ENABLE_HEALTH_SERVER=0
# PORT is injected by Railway when the service is exposed.
# PORT=8080
